# ==============================================================================
# Dove Youth Development — Environment Variable Template
# Keep all production values strictly confidential. Do NOT commit .env.local to Git.
# ==============================================================================

# Site Configuration
SITE_URL=https://www.doveyouthdevelopment.org
SITE_INDEXABLE=false

# Dedicated Dove Youth Development Supabase Project (ISOLATED from other clients)
NEXT_PUBLIC_SUPABASE_URL=https://your-dove-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary (Dedicated Dove namespace: dove-youth-development/)
CLOUDINARY_CLOUD_NAME=vloh9uw1
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Wix Official Blog API (Migration Only)
WIX_API_KEY=your_wix_api_key
WIX_SITE_ID=your_wix_site_id
WIX_ACCOUNT_ID=your_wix_account_id
